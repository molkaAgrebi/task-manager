# Copy this file to "server/.env" for local development (without Docker).
# ".env" is ignored by Git: never commit real secrets.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_NAME=taskmanager

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Optional
# PORT=5000
# CLIENT_ORIGIN=http://localhost:5173
# DB_SSL=true          # for hosted databases (Render, Neon...)
# TRUST_PROXY=1        # when running behind a hosting proxy
